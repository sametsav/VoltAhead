{
  "model_name": "xgboost",
  "versions": [
    "initial",
    "optimized"
  ],
  "seed": 42,
  "target": "1=Available, 0=Unavailable",
  "y_prob": "P(Available=1)",
  "feature_columns": [
    "station_id",
    "hour",
    "day_of_week",
    "is_weekend",
    "current_idle",
    "current_busy",
    "station_capacity",
    "occupancy_rate",
    "idle_lag_5",
    "idle_lag_10",
    "idle_lag_15",
    "idle_lag_30",
    "idle_lag_40",
    "idle_lag_60",
    "idle_lag_120",
    "prediction_horizon"
  ],
  "encoding": "OneHotEncoder(handle_unknown='ignore') on station_id; numerics passthrough",
  "initial": {
    "params": {
      "objective": "binary:logistic",
      "tree_method": "hist",
      "learning_rate": 0.05,
      "max_depth": 4,
      "n_estimators": 200,
      "min_child_weight": 1,
      "subsample": 1.0,
      "colsample_bytree": 1.0,
      "reg_alpha": 0.0,
      "reg_lambda": 1.0,
      "eval_metric": "logloss",
      "random_state": 42
    },
    "threshold": 0.5,
    "fit_period": "2022-12-01..2022-12-23"
  },
  "optimized": {
    "params": {
      "objective": "binary:logistic",
      "tree_method": "hist",
      "learning_rate": 0.1,
      "max_depth": 8,
      "min_child_weight": 5,
      "subsample": 1.0,
      "colsample_bytree": 0.8,
      "reg_alpha": 1.0,
      "reg_lambda": 1.0,
      "eval_metric": "logloss",
      "random_state": 42,
      "n_estimators": 100
    },
    "class0_sample_weight": 1.0,
    "features": [
      "station_id",
      "hour",
      "day_of_week",
      "is_weekend",
      "current_idle",
      "station_capacity",
      "idle_lag_5",
      "idle_lag_10",
      "idle_lag_15",
      "idle_lag_30",
      "idle_lag_40",
      "idle_lag_60",
      "idle_lag_120",
      "prediction_horizon"
    ],
    "feature_set": "no_redundant (-current_busy,-occupancy_rate)",
    "calibration_method": "none",
    "threshold": 0.53,
    "threshold_selection": "max Class-0 F1 on Jan 3-5 (class 0 predicted when y_prob < threshold)",
    "fit_period": "2022-12-01..2022-12-29",
    "calibration_period": "2022-12-30..2023-01-02",
    "threshold_period": "2023-01-03..2023-01-05"
  },
  "scale_pos_weight_used": false
}